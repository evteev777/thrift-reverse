# UID/GID on docker host

# Run console command: id -u 
LOCAL_UID=1000

# Run console command: id -g
LOCAL_GID=1000



# Reverse: java -> .thrift

INPUT_DIR=./input

OUTPUT_DIR=./output



# Generation: .thrift -> java 

# By default Java generation reads OUTPUT_DIR. Override when needed:
# THRIFT_INPUT_DIR=./output

JAVA_OUTPUT_DIR=./generated-java
